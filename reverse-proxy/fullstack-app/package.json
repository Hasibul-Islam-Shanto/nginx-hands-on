{
  "name": "fullstack-app",
  "version": "1.0.0",
  "description": "Fullstack Todo Application with React, Node.js, and Docker MongoDB",
  "scripts": {
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "dev": "concurrently -n \"backend,frontend\" -c \"cyan,green\" \"npm run server\" \"npm run client\"",
    "server": "npm --prefix backend run dev",
    "client": "npm --prefix frontend run dev",
    "mongo:up": "docker compose up -d mongodb",
    "mongo:down": "docker compose stop mongodb",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
